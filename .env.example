# Copy this file to `.env` (or edit the committed `.env` directly) to
# configure Kinetra's backend URLs without touching any app source code.
#
# LOCAL: your computer's LAN IP while developing with `npx expo start`, so
# your phone (on the same Wi-Fi) can reach your locally-running Flask
# server. Find yours with `ipconfig` (Windows) or `ifconfig`/`ip addr`
# (Mac/Linux). Only used in development builds (__DEV__ === true).
EXPO_PUBLIC_LOCAL_API_BASE_URL=http://192.168.1.163:5000

# DEPLOYED: the backend URL used in production/preview builds -- anything
# built with `eas build`, or exported with __DEV__ false. Replace this with
# your real hosted backend (Render, Railway, Fly.io, your own server) before
# shipping. A free-tier ngrok URL expires and will silently break the app
# for everyone already using that build once it does.
EXPO_PUBLIC_DEPLOYED_API_BASE_URL=https://your-app-name.onrender.com

# CRASH REPORTING (optional, off by default): leave unset and the app works
# exactly as it does today, with nothing reported anywhere. Set this to a
# real Sentry DSN (from your own free https://sentry.io account -- nobody
# else can create that account for you) to start reporting unhandled errors
# and the app's two real network failure points (/analyze, /ai-coach). See
# constants/crashReporting.ts for exactly what this does and does not do.
# EXPO_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
