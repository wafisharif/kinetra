# Kinetra backend URLs. Expo automatically loads this file and inlines any
# EXPO_PUBLIC_-prefixed variable into the JS bundle at build/export time --
# no extra package needed. See .env.example for what each value means.
#
# This file IS committed to git on purpose: these are non-secret, public
# client-side config (the deployed URL is visible in the shipped app bundle
# regardless of where it's defined). Never put a real secret (an API key,
# a password) in a variable prefixed EXPO_PUBLIC_ -- anything with that
# prefix ships inside the app for anyone to read. The Anthropic API key for
# AI Coach is kept out of this entirely; it lives only as a server-side
# environment variable on the Flask host (see server.py).

EXPO_PUBLIC_LOCAL_API_BASE_URL=http://192.168.1.163:5000
EXPO_PUBLIC_DEPLOYED_API_BASE_URL=https://kinetra-5w8w.onrender.com
